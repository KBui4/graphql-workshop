# GraphQL Schema

# This allows us to force resolvers; this is how we'll get our field resolvers.
directive @goField (
  forceResolver: Boolean
) on INPUT_FIELD_DEFINITION | FIELD_DEFINITION 

type User {
  id: ID!               # A ! means this field cannot be null.
  name: String!
  hobbies: [String!]!   # A ! next to a list means it cannot have any null objects.
  products: [Product!]! @goField(forceResolver: true)
}

type Product {
  id: ID!
  seller: User! @goField(forceResolver: true)
  price: Float!
  name: String!
  description: String!
}

input ProductFilter {
  nameContains: String 
  descriptionContains: String
}

# GraphQL Cheatsheet: https://devhints.io/graphql

# Challenge 1 Part A


type Query {
  # Example queries for users
  user(id: ID!): User!  # Fetches one user given an ID
  users: [User!]!       # Fetches a list of all users

  # Example queries for product
  product(id: ID!): Product!                    # Fetches one product given an ID
  products(filter: ProductFilter): [Product!]!  # Fetches a list of products by ProductFilter
                                                # (Either by name, description, or all products if empty)

  # Challenge 1 Part B


}

# Resources to learn more: 
# https://graphql.org/learn/schema/
# https://graphql.org/learn/queries/